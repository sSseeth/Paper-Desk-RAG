# Virtual environments
.venv/
venv/
env/

# Python bytecode and test caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime output. The journal (including the outbox table) is SQLite under data/,
# with WAL/SHM sidecars. The lock, redacted cycle log, and keyring-fallback
# secrets file live there too. reports/ and logs/ are written by desk.py and
# the scheduler launchers. state/ is local runtime state, including
# state/lifecycle_gate.json (sha256 prefix only; never a raw account id).
# data/mechanics/ and reports/mechanics/ belong to the mechanics paper account.
data/
reports/
logs/
state/
*.db
*.sqlite*
*.log

# Secrets. setup-secrets uses the OS keyring. Never commit a dotenv or the
# keyring fallback file (also covered by data/).
.env*
data/secrets.local.json

# OS and editor cruft
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
